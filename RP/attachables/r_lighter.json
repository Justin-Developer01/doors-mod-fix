{
   "format_version": "1.10",
   "minecraft:attachable": {
      "description": {
         "identifier": "r:lighter",
         "materials": {
            "default": "spider",
            "enchanted": "entity_alphatest_glint"
         },
         "textures": {
            "default": "textures/entity/pamobile/r_lighter",
            "enchanted": "textures/misc/enchanted_item_glint"
         },
         "geometry": {
            "default": "geometry.r_lighter"
         },
         "animations": {
            "wield_first_person": "animation.r_lighter.first_person",
            "wield_third_person": "animation.r_lighter.third_person",
            "general": "controller.animation.lighter.general",
            "use": "animation.r_lighter.use",
            "close": "animation.r_lighter.close"
         },
         "scripts": {
            "pre_animation": [
               "variable.charge_amount = math.clamp((query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) / 10.0, 0.0, 1.0f);"
            ],
            "animate": [
               {
                  "wield_first_person": "c.is_first_person"
               },
               {
                  "wield_third_person": "!c.is_first_person"
               },
               "general",
               "close"
            ]
         },
         "render_controllers": [
            "controller.render.item_default"
         ]
      }
   }
}