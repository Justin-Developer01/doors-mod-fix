{
   "format_version": "1.10.0",
   "minecraft:client_entity": {
      "description": {
         "identifier": "doors:hotel_door4_otherside",
         "materials": {
            "default": "npc"
         },
         "textures": {
            "default": "textures/entity/hotel_door4"
         },
         "geometry": {
            "default": "geometry.hotel_door4_s"
         },
         "animations": {
            "close": "animation.hotel_door.close",
            "open": "animation.hotel_door.open",
            "east": "animation.hotel_door.east",
            "north": "animation.hotel_door.north",
            "south": "animation.hotel_door.south",
            "west": "animation.hotel_door.west",
            "use": "controller.animation.hotel_door.use",
            "spin": "controller.animation.hotel_door.spin"
         },
         "scripts": {
            "animate": [
               "use",
               "spin",
               {
                  "east": "variable.is_facing_east"
               },
               {
                  "north": "variable.is_facing_north"
               },
               {
                  "south": "variable.is_facing_south"
               },
               {
                  "west": "variable.is_facing_west"
               }
            ],
            "pre_animation": [
               "variable.random = math.round(math.random(0,2));",
               "variable.entity_cardinal_direction = math.round(query.body_y_rotation / 90.0) * 90.0;",
               "variable.is_facing_south = variable.entity_cardinal_direction == 0.0 || variable.entity_cardinal_direction == 360.0;",
               "variable.is_facing_west = variable.entity_cardinal_direction == 90.0;",
               "variable.is_facing_north = variable.entity_cardinal_direction == 180.0;",
               "variable.is_facing_east = variable.entity_cardinal_direction == 270.0;"
            ]
         },
         "sound_effects": {
            "close": "mob.closet.big_door",
            "open": "mob.closet.big_door"
         },
         "render_controllers": [
            "controller.render.default"
         ],
         "spawn_egg": {
            "texture": "hotel_door4",
            "texture_index": 0
         }
      }
   }
}