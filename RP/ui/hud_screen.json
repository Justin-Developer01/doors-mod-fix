      "type": "image",
      "texture": "ui/intro/doors1",
      "layer": 40,
      "$fit_to_width": true,
      "size": [
         "100%",
         "100%"
      ],
      "fill": true,
      "alpha": "@intro1_anim"
   },
   "intro2_anim": {
      "anim_type": "alpha",
      "destroy_at_end": "start",
