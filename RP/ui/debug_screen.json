{
   "namespace": "debug_screen",
   "access_button@common_buttons.light_content_button": {
      "$pressed_button_name": "button.access",
      "size": [
         20,
         20
      ],
      "offset": [
         20,
         20
      ],
      "anchor_to": "top_left",
      "anchor_from": "top_left",
      "bindings": [
         {
            "binding_name": "#access_screen_visible",
            "binding_name_override": "#visible"
         }
      ]
   },
   "russelgametime_watermark": {
      "type": "label",
      "text": "§lDOORSV3 ADD-ON BY \n§dMetavoxel\nStudios",
      "color": [
         1,
         1,
         1
      ],
      "shadow": true,
      "font_size": "tiny",
      "anchor_from": "top_right",
      "anchor_to": "top_right",
      "alpha": 10
   },
   "russelgametime_watermark_image": {
      "type": "image",
      "texture": "textures/logo/doors",
      "layer": 3,
      "offset": [
         -5,
         30
      ],
      "anchor_from": "top_right",
      "anchor_to": "top_right",
      "size": [
         30,
         30
      ]
   },
   "special_render": {
      "type": "custom",
      "renderer": "debug_screen_renderer"
   },
   "content_panel": {
      "type": "panel",
      "clips_children": false,
      "size": [
         "100%",
         "100%"
      ],
      "controls": [
         {
            "access_button@debug_screen.access_button": {}
         },
         {
            "special_render@debug_screen.special_render": {}
         },
         {
            "russelgametime_watermark@debug_screen.russelgametime_watermark": {}
         },
         {
            "russelgametime_watermark_image@debug_screen.russelgametime_watermark_image": {}
         }
      ]
   },
   "debug_screen@common.base_screen": {
      "send_telemetry": false,
      "screen_not_flushable": true,
      "render_game_behind": true,
      "is_showing_menu": false,
      "low_frequency_rendering": true,
      "is_modal": true,
      "should_steal_mouse": false,
      "render_only_when_topmost": false,
      "screen_draws_last": true,
      "always_accepts_input": true,
      "$screen_content": "debug_screen.content_panel",
      "$screen_animations": [],
      "$use_loading_bars": true
   }
}