{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.screech_p.general": {
         "initial_state": "moving",
         "states": {
            "moving": {
               "variables": {
                  "move_speed": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 0,
                        "1": 1
                     }
                  },
                  "is_idling": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 1,
                        "1": 0
                     }
                  }
               },
               "blend_transition": 0.1,
               "animations": [
                  {
                     "moving": "variable.move_speed"
                  },
                  {
                     "screech_general": "variable.is_idling"
                  }
               ],
               "transitions": [
                  {
                     "running": "query.ground_speed >= 4.5"
                  },
                  {
                     "duck": "query.is_sneaking"
                  },
                  {
                     "bite": "query.is_sheared"
                  }
               ]
            },
            "running": {
               "animations": [
                  "moving"
               ],
               "transitions": [
                  {
                     "moving": "query.ground_speed <= 3.5"
                  }
               ],
               "blend_transition": 0.5
            },
            "duck": {
               "animations": [
                  "duck"
               ],
               "transitions": [
                  {
                     "idle": "!query.is_sneaking"
                  }
               ],
               "blend_transition": 0.2
            },
            "bite": {
               "animations": [
                  "attack"
               ],
               "transitions": [
                  {
                     "moving": "!query.is_sheared"
                  }
               ],
               "blend_transition": 0.2
            }
         }
      }
   }
}