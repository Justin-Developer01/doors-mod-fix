{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.seek_p.general": {
         "initial_state": "moving",
         "states": {
            "moving": {
               "variables": {
                  "move_speed": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 0,
                        "1": 1
                     }
                  },
                  "is_idling": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 1,
                        "1": 0
                     }
                  }
               },
               "blend_transition": 0.1,
               "animations": [
                  {
                     "moving": "variable.move_speed"
                  },
                  {
                     "figure_p_general": "variable.is_idling"
                  }
               ],
               "transitions": [
                  {
                     "running": "query.ground_speed >= 4.5"
                  },
                  {
                     "sneaking": "query.is_sneaking"
                  }
               ]
            },
            "running": {
               "animations": [
                  "running"
               ],
               "transitions": [
                  {
                     "moving": "query.ground_speed <= 3.5"
                  }
               ],
               "blend_transition": 0.5,
               "particle_effects": [
                  {
                     "effect": "spell",
                     "locator": "bright"
                  }
               ]
            },
            "sneaking": {
               "animations": [
                  "sneak"
               ],
               "transitions": [
                  {
                     "idle": "!query.is_sneaking"
                  }
               ],
               "blend_transition": 0.2,
               "particle_effects": [
                  {
                     "effect": "spell",
                     "locator": "goo"
                  }
               ]
            }
         }
      }
   }
}