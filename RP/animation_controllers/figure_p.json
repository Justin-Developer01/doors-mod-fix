{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.figure_p.general": {
         "initial_state": "moving",
         "states": {
            "moving": {
               "variables": {
                  "move_speed": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 0,
                        "1": 1
                     }
                  },
                  "is_idling": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 1,
                        "1": 0
                     }
                  }
               },
               "blend_transition": 0.1,
               "animations": [
                  {
                     "moving": "variable.move_speed"
                  },
                  {
                     "figure_p_general": "variable.is_idling"
                  }
               ],
               "transitions": [
                  {
                     "running": "query.ground_speed >= 4.5"
                  },
                  {
                     "sneaking": "query.is_sneaking"
                  },
                  {
                     "jumping": "!query.is_on_ground && !query.is_in_water && !query.is_wall_climbing"
                  },
                  {
                     "jumpscare": "query.is_roaring && query.variant == 0"
                  },
                  {
                     "sniff": "query.is_stunned"
                  },
                  {
                     "roar": "query.is_sheared"
                  }
               ],
               "particle_effects": [
                  {
                     "effect": "spell",
                     "locator": "bright"
                  }
               ]
            },
            "running": {
               "animations": [
                  "running"
               ],
               "transitions": [
                  {
                     "moving": "query.ground_speed <= 3.5"
                  }
               ],
               "blend_transition": 0.5,
               "particle_effects": [
                  {
                     "effect": "spell",
                     "locator": "bright"
                  }
               ]
            },
            "sneaking": {
               "animations": [
                  "duck"
               ],
               "transitions": [
                  {
                     "idle": "!query.is_sneaking"
                  }
               ],
               "blend_transition": 0.2
            },
            "jumping": {
               "animations": [
                  "jumping"
               ],
               "transitions": [
                  {
                     "moving": "query.is_on_ground"
                  }
               ],
               "blend_transition": 0.5
            },
            "jumpscare": {
               "animations": [
                  "jumpscare"
               ],
               "transitions": [
                  {
                     "moving": "!query.is_roaring"
                  }
               ],
               "blend_transition": 0.2
            },
            "sniff": {
               "animations": [
                  "sniff"
               ],
               "transitions": [
                  {
                     "moving": "!query.is_stunned"
                  }
               ],
               "blend_transition": 0.2
            },
            "roar": {
               "animations": [
                  "roar"
               ],
               "transitions": [
                  {
                     "moving": "!query.is_sheared"
                  }
               ],
               "blend_transition": 0.2
            }
         }
      },
      "controller.animation.figure.looking_at": {
         "states": {
            "default": {
               "animations": [
                  "look_at",
                  "look_at_target"
               ]
            }
         }
      },
      "controller.animation.figure.attack": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "attack": "variable.attack_time > 0 && variable.random == 0"
                  },
                  {
                     "attack": "variable.attack_time > 0 && variable.random == 1"
                  }
               ],
               "blend_transition": 0.2
            },
            "attack": {
               "animations": [
                  "attack"
               ],
               "transitions": [
                  {
                     "default": "query.all_animations_finished"
                  }
               ],
               "blend_transition": 0.1
            }
         }
      }
   }
}