{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.glitch.general": {
         "initial_state": "moving",
         "states": {
            "moving": {
               "variables": {
                  "move_speed": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 0,
                        "1": 1
                     }
                  },
                  "is_idling": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 1,
                        "1": 0
                     }
                  }
               },
               "blend_transition": 0.1,
               "animations": [
                  {
                     "moving": "variable.move_speed"
                  },
                  {
                     "glitch_general": "variable.is_idling"
                  },
                  "look_at_target"
               ],
               "transitions": [
                  {
                     "jumpscare": "query.has_rider && !query.is_stunned"
                  }
               ],
               "particle_effects": [
                  {
                     "effect": "spell",
                     "locator": "error2"
                  }
               ]
            },
            "jumpscare": {
               "animations": [
                  "jumpscare"
               ],
               "transitions": [
                  {
                     "moving": "!query.has_rider"
                  }
               ],
               "blend_transition": 0.2
            }
         }
      }
   }
}