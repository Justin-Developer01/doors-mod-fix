{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.jeffthekiller.general": {
         "states": {
            "default": {
               "animations": [
                  "jeffthekiller_general",
                  "look_at_target"
               ],
               "transitions": [
                  {
                     "jump": "!query.is_on_ground && !query.is_in_water && !query.is_wall_climbing"
                  }
               ]
            },
            "jump": {
               "animations": [
                  "jump"
               ],
               "transitions": [
                  {
                     "default": "query.is_on_ground"
                  }
               ],
               "blend_transition": 0.5
            }
         }
      },
      "controller.animation.jeffthekiller.dead": {
         "states": {
            "default": {
               "animations": [
                  "jeffthekiller_dead"
               ]
            }
         }
      },
      "controller.animation.jeffthekiller.stun": {
         "states": {
            "default": {
               "animations": [
                  "jeffthekiller_stun"
               ]
            }
         }
      },
      "controller.animation.jeffthekiller.general2": {
         "initial_state": "moving",
         "states": {
            "moving": {
               "animations": [
                  {
                     "moving": "query.ground_speed * 0.5"
                  },
                  "look_at_target"
               ],
               "transitions": [
                  {
                     "running": "variable.attack_time > 0 && variable.random == 0"
                  }
               ],
               "blend_transition": 0.2
            }
         }
      },
      "controller.animation.jeffthekiller.attack": {
         "states": {
            "attack1": {
               "animations": [
                  "attack1"
               ],
               "blend_transition": 0.1,
               "transitions": [
                  {
                     "default": "query.all_animations_finished"
                  }
               ]
            },
            "attack2": {
               "animations": [
                  "attack2"
               ],
               "blend_transition": 0.1,
               "transitions": [
                  {
                     "default": "query.all_animations_finished"
                  }
               ]
            },
            "default": {
               "blend_transition": 0.2,
               "transitions": [
                  {
                     "attack1": "variable.attack_time > 0 && variable.random == 0"
                  },
                  {
                     "attack2": "variable.attack_time > 0 && variable.random == 1"
                  }
               ]
            }
         }
      }
   }
}