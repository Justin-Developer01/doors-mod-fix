{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.valerabro.general": {
         "states": {
            "default": {
               "animations": [
                  "valerabro_general",
                  "look_at_target"
               ],
               "transitions": [
                  {
                     "fall": "!query.is_on_ground && !query.is_in_water && !query.is_wall_climbing"
                  },
                  {
                     "sit": "query.is_riding"
                  }
               ]
            },
            "fall": {
               "animations": [
                  "fall"
               ],
               "transitions": [
                  {
                     "default": "query.is_on_ground"
                  }
               ],
               "blend_transition": 0.5
            },
            "sit": {
               "animations": [
                  "sit"
               ],
               "transitions": [
                  {
                     "default": "!query.is_riding"
                  }
               ],
               "blend_transition": 0.2
            }
         }
      },
      "controller.animation.valerabro.general2": {
         "initial_state": "moving",
         "states": {
            "moving": {
               "animations": [
                  {
                     "moving": "query.ground_speed * 0.5"
                  },
                  "look_at_target"
               ],
               "transitions": [
                  {
                     "running": "variable.attack_time > 0 && variable.random == 0"
                  }
               ],
               "blend_transition": 0.2
            }
         }
      },
      "controller.animation.valerabro.sitting": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "sit": "query.is_riding ? (query.get_ride -> query.owner_identifier) == 'doors:modern_chair'"
                  }
               ],
               "blend_transition": 0.2
            },
            "sit": {
               "animations": [
                  "sit"
               ],
               "transitions": [
                  {
                     "default": "!query.is_riding"
                  }
               ],
               "blend_transition": 0.2
            }
         }
      },
      "controller.animation.valerabro.attack": {
         "states": {
            "attack1": {
               "animations": [
                  "attack1"
               ],
               "blend_transition": 0.1,
               "transitions": [
                  {
                     "default": "query.all_animations_finished"
                  }
               ]
            },
            "attack2": {
               "animations": [
                  "attack2"
               ],
               "blend_transition": 0.1,
               "transitions": [
                  {
                     "default": "query.all_animations_finished"
                  }
               ]
            },
            "default": {
               "blend_transition": 0.2,
               "transitions": [
                  {
                     "attack1": "variable.attack_time > 0 && variable.random == 0"
                  },
                  {
                     "attack2": "variable.attack_time > 0 && variable.random == 1"
                  }
               ]
            }
         }
      }
   }
}