{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.lsplash.general": {
         "initial_state": "moving",
         "states": {
            "moving": {
               "variables": {
                  "move_speed": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 0,
                        "1": 1
                     }
                  },
                  "is_idling": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 1,
                        "1": 0
                     }
                  }
               },
               "blend_transition": 0.1,
               "animations": [
                  {
                     "moving": "variable.move_speed"
                  },
                  {
                     "lsplash_general": "variable.is_idling"
                  }
               ],
               "transitions": [
                  {
                     "running": "query.ground_speed >= 4.5"
                  },
                  {
                     "jumping": "!query.is_on_ground && !query.is_in_water && !query.is_wall_climbing"
                  }
               ]
            },
            "running": {
               "animations": [
                  "moving"
               ],
               "transitions": [
                  {
                     "moving": "query.ground_speed <= 3.5"
                  }
               ],
               "blend_transition": 0.5
            },
            "jumping": {
               "animations": [
                  "jumping"
               ],
               "transitions": [
                  {
                     "moving": "query.is_on_ground"
                  }
               ],
               "blend_transition": 0.5
            }
         }
      },
      "controller.animation.lsplash.attack": {
         "states": {
            "attack1": {
               "animations": [
                  "attack1"
               ],
               "blend_transition": 0.1,
               "transitions": [
                  {
                     "default": "query.all_animations_finished"
                  }
               ]
            },
            "attack2": {
               "animations": [
                  "attack2"
               ],
               "blend_transition": 0.1,
               "transitions": [
                  {
                     "default": "query.all_animations_finished"
                  }
               ]
            },
            "default": {
               "blend_transition": 0.2,
               "transitions": [
                  {
                     "attack1": "variable.attack_time > 0 && variable.random == 0"
                  },
                  {
                     "attack2": "variable.attack_time > 0 && variable.random == 1"
                  }
               ]
            }
         }
      }
   }
}