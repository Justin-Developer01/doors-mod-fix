{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.door100_gate.general": {
         "initial_state": "moving",
         "states": {
            "moving": {
               "variables": {
                  "move_speed": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 0,
                        "1": 1
                     }
                  },
                  "is_idling": {
                     "input": "query.modified_move_speed",
                     "remap_curve": {
                        "0": 1,
                        "1": 0
                     }
                  }
               },
               "blend_transition": 0.1,
               "animations": [
                  {
                     "moving": "variable.move_speed"
                  },
                  {
                     "door100_gate_general": "variable.is_idling"
                  }
               ],
               "transitions": [
                  {
                     "open": "query.is_stunned"
                  },
                  {
                     "close": "query.is_sheared"
                  }
               ]
            },
            "open": {
               "animations": [
                  "open"
               ],
               "transitions": [
                  {
                     "moving": "!query.is_stunned"
                  }
               ],
               "blend_transition": 0.2
            },
            "close": {
               "animations": [
                  "close"
               ],
               "transitions": [
                  {
                     "moving": "!query.is_sheared"
                  }
               ],
               "blend_transition": 0.2
            }
         }
      }
   }
}