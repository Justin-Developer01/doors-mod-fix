				"uv": {
					"texture_width": 1024,
					"texture_height": 1024,
					"uv": [450, 0],
					"uv_size": [64, 64]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "variable.particle_random_1",
					"gradient": {
						"0.0": "#FF3CD7FF",
						"1.0": "#FF3FFFDD"
					}
				}
			}
		}
