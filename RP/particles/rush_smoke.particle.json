{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "r:rush_smoke",
			"basic_render_parameters": {
				"material": "particles_alpha",
				"texture": "textures/particles/campfire_smoke"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 40,
				"max_particles": 1000
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"offset": [0, 0.4, 0],
				"radius": 6,
				"direction": [4, 4, 4]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "Math.random(1, 1.4)"
			},
			"minecraft:particle_initial_speed": 3,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["(variable.particle_random_1-0.5)", 1.2, "(variable.particle_random_1-0.5)"]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [3, 3],
				"facing_camera_mode": "lookat_xyz",
				"uv": {
					"texture_width": 16,
					"texture_height": 192,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [16, 16],
						"step_UV": [0, 16],
						"max_frame": 32,
						"loop": true
					}
				}
			},
			"minecraft:particle_motion_collision": {
				"coefficient_of_restitution": 2
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.4": "#FF1A1919",
						"0.57": "#FF000000"
					}
				}
			}
		}
	}
}