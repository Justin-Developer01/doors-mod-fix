{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.figure_scene_shake": {
         "states": {
            "default": {
               "on_entry": [
                  "/execute @s ~~~ camerashake add @a[r=30] 0.3 0.05 positional"
               ],
               "transitions": [
                  {
                     "shake": "query.has_target"
                  }
               ]
            },
            "shake": {
               "on_entry": [],
               "transitions": [
                  {
                     "default": "!query.has_target"
                  }
               ]
            }
         }
      },
      "controller.animation.figure_scene_shake2": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "shake2": "(1.0)"
                  }
               ],
               "on_entry": [
                  "/execute @e[type=r:shake2] ~~~ effect @a slowness 1 5 true",
                  "/execute @e[type=r:shake2] ~~~ effect @a blindness 1 5 true"
               ]
            },
            "shake2": {
               "transitions": [
                  {
                     "default": "(1.0)"
                  }
               ],
               "on_entry": [
                  "/execute @e[type=r:shake2] ~~~ effect @a slowness 1 5 true",
                  "/execute @e[type=r:shake2] ~~~ effect @a blindness 1 5 true"
