{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.seek_sneak": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "sneak": "query.is_sneaking"
                  }
               ],
               "on_entry": [
                  "/execute @e[tag=morph3,r=2] ~~~ effect @s slowness 1 3 true",
                  "/tp @s[tag=morph3,r=2] ~~~",
                  "/function gamerules"
               ]
            },
            "sneak": {
               "transitions": [
                  {
                     "default": "query.is_sneaking"
                  }
               ],
               "on_entry": []
            }
         }
      }
   }
}