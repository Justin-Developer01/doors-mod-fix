{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.jumpscare_figure": {
         "initial_state": "default",
         "states": {
            "default": {
               "transitions": [
                  {
                     "attacking": "variable.attack_time > 0 && !query.is_stunned"
                  },
                  {
                     "adding": "query.has_rider && !query.is_stunned"
                  }
               ]
            },
            "attacking": {
               "transitions": [
                  {
                     "default": "1.0"
                  }
               ],
               "on_entry": [
                  "/function jumpscare"
               ]
            },
            "adding": {
               "transitions": [
                  {
                     "default": "1.0"
                  }
               ],
               "on_entry": []
            }
         }
      }
   }
}