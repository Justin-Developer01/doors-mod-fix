{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.figure_detected": {
         "states": {
            "default": {
               "on_entry": [],
               "transitions": [
                  {
                     "detected": "query.has_target"
                  }
               ]
            },
            "detected": {
               "on_entry": [
                  "/summon r:figure_blast",
                  "/camerashake add @a 0.2 1 positional",
                  "/playsound mob.figure.roar @a"
               ],
               "transitions": [
                  {
                     "default": "!query.has_target"
                  }
               ]
            }
         }
      }
   }
}