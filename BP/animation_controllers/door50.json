{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.door50_closed": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "door50_close": "query.mark_variant == 1"
                  },
                  {
                     "door50_open": "query.mark_variant == 2"
                  }
               ]
            },
            "door50_close": {
               "transitions": [
                  {
                     "default": "query.mark_variant != 1"
                  }
               ],
               "on_entry": [
                  "/execute @s ~~~ fill ~~~ ~~2~ barrier"
               ]
            },
            "door50_open": {
               "transitions": [
                  {
                     "default": "query.mark_variant != 2"
                  }
               ],
               "on_entry": [
                  "/execute @s ~~~ fill ~~~ ~~2~ air 0 replace barrier"
               ]
            }
         }
      },
      "controller.animation.door50_facing": {
         "states": {
            "default": {
               "on_entry": [
                  "/effect @s resistance 10000 255 true",
                  "/effect @s instant_health 10000 255 true"
               ],
               "transitions": [
                  {
                     "facing": "query.has_target"
                  }
               ]
            },
            "facing": {
               "on_entry": [],
               "transitions": [
                  {
                     "default": "!query.has_target"
                  }
               ]
            }
         }
      }
   }
}