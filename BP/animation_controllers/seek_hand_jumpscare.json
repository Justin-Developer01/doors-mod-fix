{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.jumpscare_seek_hand": {
         "initial_state": "default",
         "states": {
            "default": {
               "transitions": [
                  {
                     "attacking": "variable.attack_time > 0 && !query.is_stunned"
                  },
                  {
                     "adding": "query.has_rider && !query.is_stunned"
                  }
               ]
            },
            "attacking": {
               "transitions": [
                  {
                     "default": "1.0"
                  }
               ],
               "on_entry": [
                  "/function hand_grab",
                  "/tp @e[type=r:seek_hand_wait,r=2] @e[type=!doors:seek_hand]",
                  "/tag @s add hand"
               ]
            },
            "adding": {
               "transitions": [
                  {
                     "default": "1.0"
                  }
               ],
               "on_entry": [
                  "/scoreboard objectives add hand dummy",
                  "/scoreboard players add @e[r=3,type=!doors:seek_hand] hand 1",
                  "/execute @e[scores={hand=45..1000}] ~ ~ ~ function hand_stop",
                  "/execute @e[scores={hand=45..1000}] ~ ~ ~ tag @e[type=doors:seek_hand,r=2] remove hand",
                  "/scoreboard players set @a[scores={hand=45..1000}] hand 0"
               ]
            }
         }
      }
   }
}