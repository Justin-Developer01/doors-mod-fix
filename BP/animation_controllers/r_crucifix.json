{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.r_crucifix": {
      "initial_state": "preshoot",
      "states": {
        "preshoot": {
          "transitions": [
            {
              "shoot": "(q.get_equipped_item_name(0) == 'crucifix' || q.get_equipped_item_name == 'crucifix' || q.is_item_name_any('slot.weapon.mainhand', 'r:crucifix', 'crucifix')) && q.is_using_item"
            }
          ]
        },
        "shooting": {
          "on_entry": [
            "v.delaytime = q.life_time;"
          ],
          "transitions": [
            {
              "preshoot": "!((q.get_equipped_item_name(0) == 'crucifix' || q.get_equipped_item_name == 'crucifix' || q.is_item_name_any('slot.weapon.mainhand', 'r:crucifix', 'crucifix'))) || !q.is_using_item"
            },
            {
              "shoot": "!((q.get_equipped_item_name(0) == 'crucifix' || q.get_equipped_item_name == 'crucifix' || q.is_item_name_any('slot.weapon.mainhand', 'r:crucifix', 'crucifix'))) || !q.is_using_item"
            }
          ]
        },
        "shoot": {
          "on_entry": [
            "@s r:crucifix_fire",
            "/playsound r_crucifix_shot"
          ],
          "transitions": [
            {
              "shooting": "1.0"
            }
          ],
          "on_exit": [
            "v.bullet_fire = q.life_time;"
          ]
        }
      }
    }
  }
}