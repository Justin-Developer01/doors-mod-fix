{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.is_protect": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "protect": "(1.0)"
                  }
               ],
               "on_entry": [
                  "/effect @p[tag=protect,r=1] regeneration 1 5 true",
                  "/effect @p[tag=protect,r=1] resistance 1 3 true",
                  "/tp @s @e[tag=protect,r=2]"
               ]
            },
            "protect": {
               "transitions": [
                  {
                     "default": "(1.0)"
                  }
               ],
               "on_entry": []
            }
         }
      },
      "controller.animation.is_protect2": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "protect2": "query.has_target"
                  }
               ],
               "on_entry": [
                  "/tag @p[r=1] add protect",
                  "/tp @s @e[tag=protect,c=1]"
               ]
            },
            "protect2": {
               "transitions": [
                  {
                     "default": "!query.has_target"
                  }
               ],
               "on_entry": []
            }
         }
      }
   }
}