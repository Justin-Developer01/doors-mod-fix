{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.eyes_spawn": {
         "states": {
            "default": {
               "on_entry": [
                  "/playsound mob.eyes.spawn @a[r=40]"
               ],
               "transitions": [
                  {
                     "spawn": "query.has_target"
                  }
               ]
            },
            "spawn": {
               "on_entry": [],
               "transitions": [
                  {
                     "default": "!query.has_target"
                  }
               ]
            }
         }
      },
      "controller.animation.eyes_spawn2": {
         "states": {
            "default": {
               "on_entry": [
                  "/playsound mob.eyes.scared @a[r=40]",
                  "/playsound mob.eyes.panic @a[r=40]"
               ],
               "transitions": [
                  {
                     "spawn2": "query.has_target"
                  }
               ]
            },
            "spawn2": {
               "on_entry": [],
               "transitions": [
                  {
                     "default": "!query.has_target"
                  }
               ]
            }
         }
      }
   }
}