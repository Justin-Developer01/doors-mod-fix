{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.stare_look": {
         "states": {
            "default": {
               "on_entry": [
                  "/event entity @s r:start_attack"
               ],
               "transitions": [
                  {
                     "look": "query.has_target"
                  }
               ]
            },
            "look": {
               "on_entry": [
                  "/event entity @s r:remove_attack"
               ],
               "transitions": [
                  {
                     "default": "!query.has_target && (1.0)"
                  }
               ]
            }
         }
      },
      "controller.animation.stare_stop": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "stop": "(1.0)"
                  }
               ],
               "on_entry": [
                  "/event entity @e[type=doors:stare,r=2] r:remove_attack"
               ]
            },
            "stop": {
               "transitions": [
                  {
                     "default": "(1.0)"
                  }
               ],
               "on_entry": [
                  "/event entity @e[type=doors:stare,r=2] r:remove_attack"
               ]
            }
         }
      }
   }
}