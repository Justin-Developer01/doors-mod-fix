                  {
                     "default": "!query.is_item_name_any('slot.armor.head','r:empty')"
                  }
               ],
               "on_entry": [
                  "/event entity @s minecraft:remove",
                  "/replaceitem entity @s slot.armor.head 0 r:empty"
               ]
            }
         }
      },
