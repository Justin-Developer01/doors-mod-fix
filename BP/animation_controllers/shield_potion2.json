{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.r_shield_potion2": {
         "initial_state": "preshoot",
         "states": {
            "preshoot": {
               "transitions": [
                  {
                     "shoot": "q.get_equipped_item_name(0) == 'shield_potion2' && q.is_using_item"
                  }
               ]
            },
            "shooting": {
               "on_entry": [
                  "v.delaytime = q.life_time;"
               ],
               "transitions": [
                  {
                     "preshoot": "q.get_equipped_item_name(0) != 'shield_potion2' || !q.is_using_item"
                  },
                  {
                     "shoot": "q.get_equipped_item_name(0) != 'shield_potion2' || !q.is_using_item"
                  }
               ]
            },
            "shoot": {
               "on_entry": [
                  "@s r:shield_potion_fire2",
                  "/playsound mob.closet.drink @s"
               ],
               "transitions": [
                  {
                     "shooting": "1.0"
                  }
               ],
               "on_exit": [
                  "v.bullet_fire = q.life_time;"
               ]
            }
         }
      }
   }
}