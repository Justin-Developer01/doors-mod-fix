{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.hide_closet2": {
         "states": {
            "default": {
               "transitions": [
                  {
                     "hide": "query.has_rider"
                  },
                  {
                     "not_hide": "!query.has_rider"
                  }
               ]
            },
            "hide": {
               "transitions": [
                  {
                     "default": "!query.has_rider"
                  }
               ],
               "on_entry": [
                  "/execute @s ~~~ effect @e[type=!doors:closet,type=!doors:closet2,type=!doors:jack,type=!doors:screech,type=!doors:halt,type=!doors:seek,type=!doors:seek_s,type=!doors:figure,type=!doors:figure2,type=!doors:figure3,type=!doors:figure4,type=!doors:rush,type=!doors:ambush,r=3,c=1] invisibility 100000 1 true",
                  "/playsound mob.figure.heartbeat2 @p[r=40]",
                  "/event entity @e[type=!player,r=6] r:begin_minigame",
                  "/give @p r:heartbeat_item",
                  "/playsound mob.closet.hide @a",
                  "/execute @e[tag=!closet] ~~~ tag @a[c=1,r=3] add closet",
                  "/effect @p resistance 10000 255 true",
                  "/effect @e[type=!player,r=6] slowness 10000 255 true",
                  "/effect @p invisibility 10000 255 true"
               ]
            },
            "not_hide": {
               "transitions": [
                  {
                     "default": "query.has_rider"
                  }
               ],
               "on_entry": [
                  "/execute @s ~~~ effect @e[type=!doors:closet,type=!doors:jack,type=!doors:seek,type=!doors:seek_s,r=3] invisibility 0 0 true",
                  "/execute @e[tag=closet] ~~~ tag @a[c=1,r=3] remove closet",
                  "/effect @e[type=doors:figure] clear",
                  "/kill @e[type=r:figure_wait3]",
                  "/summon r:kill",
                  "/effect @p clear",
                  "/playsound mob.closet.expose @a",
                  "/clear @p r:heartbeat_item",
                  "/event entity @e[type=!player,r=6] r:stop_minigame"
               ]
            }
         }
      },
      "controller.animation.closet_remove2": {
         "states": {
            "default": {
               "on_entry": [
                  "/kill @e[type=r:heartbeat_attack]",
                  "/kill @e[type=r:heartbeat_load]",
                  "/gamerule commandblockoutput false",
                  "/gamerule sendcommandfeedback false"
               ],
               "transitions": [
                  {
                     "remove2": "query.has_target"
                  }
               ]
            },
            "remove2": {
               "on_entry": [],
               "transitions": [
                  {
                     "default": "!query.has_target"
                  }
               ]
            }
         }
      }
   }
}