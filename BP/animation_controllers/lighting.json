{
   "format_version": "1.10.0",
   "animation_controllers": {
      "controller.animation.lighting": {
         "initial_state": "default",
         "states": {
            "default": {
               "animations": [
                  "lighting_off"
               ],
               "transitions": [
                  {
                     "glow": "query.is_item_name_any('slot.armor.head','minecraft:stone')"
                  }
               ]
            },
            "glow": {
               "animations": [
                  "lighting_on"
               ],
               "transitions": [
                  {
                     "default": "!query.is_item_name_any('slot.armor.head','minecraft:stone') || !query.is_item_name_any('slot.weapon.mainhand','ic:flashlight')"
                  }
               ]
            }
         }
      }
   }
}