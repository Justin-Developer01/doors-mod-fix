{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:figure_elevator_scene",
         "is_spawnable": false,
         "is_summonable": true,
         "is_experimental": false,
         "scripts": {
            "animate": [
               "shake3"
            ]
         },
         "animations": {
            "shake3": "controller.animation.figure_scene_shake3"
         }
      },
      "component_groups": {
         "minecraft:is_dead": {
            "minecraft:transformation": {
               "into": "doors:figure_elevator_scene"
            }
         },
         "despawning": {
            "minecraft:type_family": {
               "family": [
                  "despawer",
                  "despawer_despawning",
                  "inanimate"
               ]
            }
         }
      },
      "components": {
         "minecraft:knockback_resistance": {
            "value": 50
         },
         "minecraft:push_through": {
            "value": 1
         },
         "minecraft:is_sheared": {},
         "minecraft:fire_immune": true,
         "minecraft:health": {
            "value": {
               "range_min": 10,
               "range_max": 10
            }
         },
         "minecraft:physics": {
            "has_gravity": true,
            "has_collusion": false
         },
         "minecraft:damage_sensor": {
            "triggers": [
               {
                  "cause": "fatal",
                  "deals_damage": false
               }
            ]
         },
         "minecraft:on_death": {
            "event": "on:death",
            "target": "self"
         },
         "minecraft:scale": {
            "value": 1.3
         },
         "minecraft:despawn": {
            "filters": {
               "all_of": [
                  {
                     "any_of": [
                        {
                           "test": "is_family",
                           "subject": "self",
                           "value": "despawer_despawning"
                        }
                     ]
                  }
               ]
            }
         },
         "minecraft:timer": {
            "looping": false,
            "randomInterval": false,
            "time": 10,
            "time_down_event": {
               "event": "minecraft:start_despawn",
               "target": "self"
            }
         },
         "minecraft:spawn_entity": [
            {
               "min_wait_time": 0,
               "max_wait_time": 0,
               "single_use": true,
               "spawn_entity": "r:cutscene_ui",
               "num_to_spawn": 1
            }
         ]
      },
      "events": {
         "on:death": {
            "add": {
               "component_groups": [
                  "minecraft:is_dead"
               ]
            }
         },
         "minecraft:start_despawn": {
            "add": {
               "component_groups": [
                  "despawning"
               ]
            }
         }
      }
   }
}