{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "r:cutscene_on",
         "is_spawnable": true,
         "is_summonable": true,
         "is_experimental": false
      },
      "component_groups": {
         "r:active": {
            "minecraft:transformation": {
               "into": "doors:figure_fire_start"
            }
         }
      },
      "components": {
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:experience_reward": {
            "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
         },
         "minecraft:health": {
            "value": 500
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:spell_effects": {
            "add_effects": [
               {
                  "effect": "instant_health",
                  "duration": 100000,
                  "visible": false,
                  "amplifier": 255,
                  "display_on_screen_animation": false
               }
            ]
         },
         "minecraft:collision_box": {
            "width": 0.7,
            "height": 1
         },
         "minecraft:scale": {
            "value": 1
         },
         "minecraft:movement.basic": {},
         "minecraft:jump.static": {},
         "minecraft:knockback_resistance": {
            "value": 50
         },
         "minecraft:fall_damage": {
            "value": 0
         },
         "minecraft:physics": {},
         "minecraft:interact": {
            "interactions": [
               {
                  "on_interact": {
                     "filters": {
                        "all_of": [
                           {
                              "test": "has_equipment",
                              "subject": "other",
                              "domain": "hand",
                              "value": "r:rotate_lock"
                           }
                        ]
                     },
                     "event": "minecraft:rotate",
                     "target": "self"
                  },
                  "interact_text": "§lRotate"
               }
            ]
         }
      },
      "events": {
         "minecraft:rotate": {
            "run_command": {
               "command": [
                  "tp @s ~~~ facing @p"
               ],
               "target": "self"
            },
            "weight": 1
         },
         "r:active": {
            "add": {
               "component_groups": [
                  "r:active"
               ]
            }
         }
      }
   }
}