{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:bookshelf",
         "is_spawnable": true,
         "is_summonable": true,
         "is_experimental": false
      },
      "component_groups": {
         "minecraft:is_dead": {
            "minecraft:transformation": {
               "into": "doors:bookshelf_d"
            }
         }
      },
      "components": {
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:health": {
            "value": 20
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:collision_box": {
            "width": 0.5,
            "height": 0.75
         },
         "minecraft:knockback_resistance": {
            "value": 50
         },
         "minecraft:loot": {
            "table": "loot_tables/entities/noloot.json"
         },
         "minecraft:is_stackable": {},
         "minecraft:physics": {},
         "minecraft:scale": {
            "value": 1
         },
         "minecraft:interact": {
            "interactions": [
               {
                  "on_interact": {
                     "filters": {
                        "all_of": [
                           {
                              "test": "has_equipment",
                              "subject": "other",
                              "domain": "hand",
                              "value": "r:rotate_lock"
                           }
                        ]
                     },
                     "event": "minecraft:rotate",
                     "target": "self"
                  },
                  "interact_text": "§lRotate"
               }
            ]
         },
         "minecraft:on_death": {
            "event": "on:death",
            "target": "self"
         }
      },
      "events": {
         "on:death": {
            "add": {
               "component_groups": [
                  "minecraft:is_dead"
               ]
            },
            "run_command": {
               "command": [
                  "summon r:stand_back"
               ],
               "target": "self"
            },
            "weight": 1
         },
         "minecraft:rotate": {
            "run_command": {
               "command": [
                  "tp @s ~~~ facing @p"
               ],
               "target": "self"
            },
            "weight": 1
         }
      }
   }
}