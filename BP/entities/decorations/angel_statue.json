{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:angel_statue",
         "is_spawnable": true,
         "is_summonable": true,
         "is_experimental": false
      },
      "components": {
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:experience_reward": {
            "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
         },
         "minecraft:health": {
            "value": 500
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:spell_effects": {
            "add_effects": [
               {
                  "effect": "instant_health",
                  "duration": 100000,
                  "visible": false,
                  "amplifier": 255,
                  "display_on_screen_animation": false
               }
            ]
         },
         "minecraft:collision_box": {
            "width": 0.9,
            "height": 3
         },
         "minecraft:scale": {
            "value": 2
         },
         "minecraft:movement.basic": {},
         "minecraft:navigation.climb": {
            "can_path_over_water": true,
            "can_pass_doors": true,
            "can_open_doors": true,
            "can_path_from_air": true
         },
         "minecraft:jump.static": {},
         "minecraft:knockback_resistance": {
            "value": 50
         },
         "minecraft:fall_damage": {
            "value": 0
         },
         "minecraft:physics": {
            "has_gravity": false,
            "has_collision": false
         },
         "minecraft:interact": {
            "interactions": [
               {
                  "on_interact": {
                     "filters": {
                        "all_of": [
                           {
                              "test": "is_family",
                              "subject": "other",
                              "value": "player"
                           },
                           {
                              "test": "has_ability",
                              "subject": "other",
                              "operator": "equals",
                              "value": "invulnerable"
                           }
                        ]
                     },
                     "event": "minecraft:rotate",
                     "target": "self"
                  },
                  "interact_text": "§lRotate"
               }
            ]
         }
      },
      "events": {
         "minecraft:rotate": {
            "run_command": {
               "command": [
                  "tp @s ~~~ facing @p"
               ],
               "target": "self"
            },
            "weight": 1
         }
      }
   }
}