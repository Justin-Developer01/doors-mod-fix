{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "r:red_chain",
         "is_spawnable": false,
         "is_summonable": true,
         "is_experimental": false
      },
      "component_groups": {
         "minecraft:remove": {
            "minecraft:despawn": {}
         },
         "minecraft:despawndead": {
            "minecraft:type_family": {
               "family": [
                  "despawn_"
               ]
            }
         }
      },
      "components": {
         "minecraft:attack": {
            "damage": 0
         },
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:collision_box": {
            "height": 2,
            "width": 0.4
         },
         "minecraft:underwater_movement": {
            "value": 0.06
         },
         "minecraft:movement.generic": {},
         "minecraft:jump.static": {},
         "minecraft:can_climb": {},
         "minecraft:health": {
            "value": 700,
            "max": 700
         },
         "minecraft:movement": {
            "value": 0
         },
         "minecraft:navigation.generic": {
            "is_amphibious": true,
            "can_path_over_water": false,
            "can_break_doors": true,
            "can_swim": false,
            "can_walk": true,
            "avoid_sun": false
         },
         "minecraft:behavior.move_towards_restriction": {
            "priority": 5,
            "speed_multiplier": 1
         },
         "minecraft:behavior.random_stroll": {
            "priority": 6,
            "speed_multiplier": 1
         },
         "minecraft:behavior.look_at_player": {
            "priority": 7,
            "look_distance": 6,
            "probability": 0.02
         },
         "minecraft:behavior.random_look_around": {
            "priority": 7
         },
         "minecraft:behavior.hurt_by_target": {
            "priority": 3
         },
         "minecraft:physics": {},
         "minecraft:experience_reward": {
            "on_death": "query.last_hit_by_player ? 10 : 0"
         },
         "minecraft:scale": {
            "value": 2
         },
         "minecraft:behavior.melee_attack": {
            "priority": 2,
            "speed_multiplier": 13,
            "target_dist": 0,
            "max_dist": 3,
            "random_stop_interval": 100,
            "track_target": true,
            "reach_multiplier": 1
         },
         "minecraft:behavior.owner_hurt_by_target": {
            "priority": 1
         },
         "minecraft:behavior.owner_hurt_target": {
            "priority": 2
         },
         "minecraft:behavior.float": {
            "priority": 2,
            "speed_multiplier": 1
         },
         "minecraft:knockback_resistance": {
            "value": 200
         },
         "minecraft:follow_range": {
            "value": 200
         },
         "minecraft:on_death": {
            "event": "on:death",
            "target": "self"
         },
         "minecraft:despawn": {
            "filters": {
               "all_of": [
                  {
                     "test": "is_family",
                     "subject": "self",
                     "value": "despawn_"
                  }
               ]
            }
         },
         "minecraft:timer": {
            "looping": false,
            "randomInterval": false,
            "time": 4,
            "time_down_event": {
               "event": "minecraft:event_dead"
            }
         }
      },
      "events": {
         "on:death": {
            "randomize": [
               {
                  "run_command": {
                     "command": [
                        "function remove_light",
                        "summon r:removelight"
                     ]
                  },
                  "weight": 1
               }
            ]
         },
         "minecraft:remove": {
            "add": {
               "component_groups": [
                  "minecraft:remove"
               ]
            }
         },
         "minecraft:event_dead": {
            "add": {
               "component_groups": [
                  "minecraft:despawndead"
               ]
            }
         }
      }
   }
}