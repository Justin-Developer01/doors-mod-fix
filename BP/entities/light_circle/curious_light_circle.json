{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:curious_light_circle",
         "is_spawnable": false,
         "is_summonable": true,
         "is_experimental": false,
         "scripts": {
            "animate": [
               "trap",
               "trap3"
            ]
         },
         "animations": {
            "trap": "controller.animation.curious_light_trap",
            "trap3": "controller.animation.curious_light_trap3"
         }
      },
      "component_groups": {
         "minecraft:remove": {
            "minecraft:despawn": {}
         },
         "minecraft:despawndead": {
            "minecraft:type_family": {
               "family": [
                  "despawn_"
               ]
            }
         },
         "minecraft:transform_to_red": {
            "minecraft:transformation": {
               "into": "doors:red_circle"
            }
         }
      },
      "components": {
         "minecraft:attack": {
            "damage": 0
