                        "summon r:removelight"
                     ]
                  },
                  "weight": 1
               }
            ]
         },
         "minecraft:remove": {
            "add": {
               "component_groups": [
                  "minecraft:remove"
               ]
            }
         },
         "minecraft:event_dead": {
            "add": {
               "component_groups": [
                  "minecraft:despawndead"
               ]
            }
         },
         "minecraft:event_spawn_dead": {
            "remove": {},
            "add": {
               "component_groups": [
                  "minecraft:transform_to_red"
               ]
            }
         }
