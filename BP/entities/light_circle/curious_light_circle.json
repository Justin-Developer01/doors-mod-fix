            "event": "on:death",
            "target": "self"
         },
         "minecraft:despawn": {
            "filters": {
               "all_of": [
                  {
                     "test": "is_family",
                     "subject": "self",
                     "value": "despawn_"
                  }
               ]
            }
         },
         "minecraft:timer": {
            "looping": false,
            "randomInterval": false,
            "time": 8,
            "time_down_event": {
               "event": "minecraft:event_dead"
            }
         },
         "minecraft:spawn_entity": [
            {
               "min_wait_time": 6,
               "max_wait_time": 6,
               "spawn_entity": "r:banish2",
               "spawn_sound": "as",
               "num_to_spawn": 1
            },
            {
               "min_wait_time": 0,
               "max_wait_time": 0,
               "spawn_entity": "r:blue_chain",
               "spawn_event": "minecraft:entity_spawned",
               "num_to_spawn": 1,
               "single_use": true
            },
            {
               "min_wait_time": 4,
               "max_wait_time": 4,
               "spawn_entity": "r:orange_light",
               "spawn_event": "minecraft:entity_spawned",
               "num_to_spawn": 1,
               "single_use": true
            }
         ],
         "minecraft:damage_sensor": {
