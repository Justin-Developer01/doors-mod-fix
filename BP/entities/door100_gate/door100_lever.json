{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:door100_lever",
         "is_spawnable": true,
         "is_summonable": true,
         "is_experimental": false
      },
      "component_groups": {
         "minecraft:remove": {
            "minecraft:despawn": {}
         },
         "minecraft:is_opening": {
            "minecraft:interact": {
               "interactions": [
                  {
                     "hurt_item": 0,
                     "interact_text": "§lOpen Gate",
                     "on_interact": {
                        "event": "minecraft:opening",
                        "target": "self",
                        "filters": {
                           "all_of": [
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "value": "player"
                              }
                           ]
                        }
                     },
                     "swing": true,
                     "use_item": false
                  }
               ]
            }
         },
         "r:open": {
            "minecraft:is_stunned": {}
         },
         "r:closee": {
            "minecraft:timer": {
               "looping": false,
               "randomInterval": false,
               "time": 5,
               "time_down_event": {
                  "event": "minecraft:entity_spawned"
               }
            }
         },
         "r:close": {
            "minecraft:is_sheared": {}
         },
         "minecraft:is_closing": {
            "minecraft:interact": {
               "interactions": [
                  {
                     "hurt_item": 0,
                     "interact_text": "§lClose Gate",
                     "on_interact": {
                        "event": "minecraft:closing",
                        "target": "self",
                        "filters": {
                           "all_of": [
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "value": "player"
                              }
                           ]
                        }
                     },
                     "swing": true,
                     "use_item": false
                  }
               ]
            }
         },
         "minecraft:is_closing_wait": {
            "minecraft:timer": {
               "looping": false,
               "randomInterval": false,
               "time": 5,
               "time_down_event": {
                  "event": "r:gate_wait_done"
               }
            }
         }
      },
      "components": {
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:health": {
            "value": 20
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:collision_box": {
            "width": 0.5,
            "height": 0.75
         },
         "minecraft:knockback_resistance": {
            "value": 50
         },
         "minecraft:loot": {
            "table": "loot_tables/entities/noloot.json"
         },
         "minecraft:is_stackable": {},
         "minecraft:scale": {
            "value": 1
         },
         "minecraft:on_death": {
            "event": "on:death",
            "target": "self"
         },
         "minecraft:damage_sensor": {
            "triggers": [
               {
                  "cause": "entity_attack",
                  "deals_damage": false
               },
               {
                  "cause": "suffocation",
                  "deals_damage": false
               },
               {
                  "cause": "projectile",
                  "deals_damage": false
               },
               {
                  "cause": "explosion",
                  "deals_damage": false
               },
               {
                  "cause": "fire",
                  "deals_damage": false
               }
            ]
         },
         "minecraft:physics": {
            "has_gravity": false,
            "has_collision": true
         }
      },
      "events": {
         "minecraft:closed": {
            "add": {
               "component_groups": [
                  "minecraft:is_closing_wait"
               ]
            },
            "remove": {
               "component_groups": [
                  "minecraft:is_opening"
               ]
            }
         },
         "minecraft:closing2": {
            "add": {
               "component_groups": [
                  "minecraft:is_closing2"
               ]
            }
         },
         "minecraft:remove": {
            "add": {
               "component_groups": [
                  "minecraft:remove"
               ]
            }
         },
         "r:open": {
            "add": {
               "component_groups": [
                  "r:open"
               ]
            },
            "remove": {
               "component_groups": [
                  "r:close"
               ]
            }
         },
         "r:close": {
            "add": {
               "component_groups": [
                  "r:close"
               ]
            },
            "remove": {
               "component_groups": [
                  "r:open"
               ]
            }
         },
         "r:closee": {
            "add": {
               "component_groups": [
                  "r:closee"
               ]
            }
         },
         "r:gate_wait_done": {
            "add": {
               "component_groups": [
                  "minecraft:is_closing"
               ]
            }
         },
         "minecraft:entity_spawned": {
            "add": {
               "component_groups": [
                  "minecraft:is_opening"
               ]
            }
         },
         "on:death": {
            "add": {
               "component_groups": [
                  "minecraft:is_dead",
                  "minecraft:entity_spawned"
               ]
            }
         },
         "minecraft:opening": {
            "run_command": {
               "command": [
                  "event entity @s minecraft:closed",
                  "event entity @s r:open",
                  "event entity @e[type=doors:door100_gate,r=6] minecraft:opening",
                  "function open_gates"
               ],
               "target": "self"
            },
            "weight": 1
         },
         "minecraft:closing": {
            "weight": 1,
            "run_command": {
               "command": [
                  "event entity @s r:closee",
                  "event entity @s r:close",
                  "event entity @e[type=doors:door100_gate,r=6] minecraft:closing",
                  "function close_gates"
               ],
               "target": "self"
            }
         },
         "minecraft:rotate": {
            "run_command": {
               "command": [
                  "tp @s ~~~ facing @p"
               ],
               "target": "self"
            },
            "weight": 1
         }
      }
   }
}