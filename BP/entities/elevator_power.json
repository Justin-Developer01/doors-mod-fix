{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:elevator_power",
         "is_spawnable": true,
         "is_summonable": true,
         "is_experimental": false
      },
      "component_groups": {
         "minecraft:remove": {
            "minecraft:despawn": {}
         },
         "minecraft:is_opening": {
            "minecraft:interact": {
               "interactions": [
                  {
                     "hurt_item": 0,
                     "interact_text": "§lOpen",
                     "on_interact": {
                        "event": "minecraft:opening",
                        "target": "self",
                        "filters": {
                           "all_of": [
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "value": "player"
                              }
                           ]
                        }
                     },
                     "swing": true,
                     "use_item": false
                  }
               ]
            }
         },
         "r:open": {
            "minecraft:is_stunned": {}
         },
         "r:close": {
            "minecraft:is_sheared": {}
         },
         "minecraft:is_closing": {
            "minecraft:interact": {
               "interactions": [
                  {
                     "hurt_item": 0,
                     "interact_text": "§lClose",
                     "on_interact": {
                        "event": "minecraft:closing",
                        "target": "self",
                        "filters": {
                           "all_of": [
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "value": "player"
                              }
                           ]
                        }
                     },
                     "swing": true,
                     "use_item": false
                  }
               ]
            }
         },
         "r:open_breaker": {
            "minecraft:transformation": {
               "into": "doors:elevator_power2"
            }
         }
      },
      "components": {
         "minecraft:interact": {
            "interactions": [
               {
                  "hurt_item": 0,
                  "interact_text": "§lAccess Breaker Power",
                  "on_interact": {
                     "filters": {
                        "all_of": [
                           {
                              "test": "has_equipment",
                              "subject": "other",
                              "domain": "hand",
                              "value": "r:hammer"
                           }
                        ]
                     },
                     "event": "minecraft:is_started",
                     "target": "self"
                  },
                  "swing": true,
                  "use_item": false
               }
            ]
         },
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:health": {
            "value": 20
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:collision_box": {
            "width": 0.5,
            "height": 0.75
         },
         "minecraft:knockback_resistance": {
            "value": 50
         },
         "minecraft:loot": {
            "table": "loot_tables/entities/noloot.json"
         },
         "minecraft:is_stackable": {},
         "minecraft:scale": {
            "value": 0.7
         },
         "minecraft:damage_sensor": {
            "triggers": [
               {
                  "cause": "entity_attack",
                  "deals_damage": false
               },
               {
                  "cause": "suffocation",
                  "deals_damage": false
               },
               {
                  "cause": "projectile",
                  "deals_damage": false
               },
               {
                  "cause": "explosion",
                  "deals_damage": false
               },
               {
                  "cause": "fire",
                  "deals_damage": false
               }
            ]
         },
         "minecraft:physics": {
            "has_gravity": false,
            "has_collision": true
         }
      },
      "events": {
         "minecraft:closed": {
            "add": {
               "component_groups": [
                  "minecraft:is_closing"
               ]
            },
            "remove": {
               "component_groups": [
                  "minecraft:is_opening"
               ]
            }
         },
         "minecraft:remove": {
            "add": {
               "component_groups": [
                  "minecraft:remove"
               ]
            }
         },
         "r:open": {
            "add": {
               "component_groups": [
                  "r:open"
               ]
            },
            "remove": {
               "component_groups": [
                  "r:close"
               ]
            }
         },
         "r:open_breaker": {
            "add": {
               "component_groups": [
                  "r:open_breaker"
               ]
            }
         },
         "r:close": {
            "add": {
               "component_groups": [
                  "r:close"
               ]
            },
            "remove": {
               "component_groups": [
                  "r:open"
               ]
            }
         },
         "minecraft:opening": {
            "run_command": {
               "command": [
                  "event entity @s minecraft:closed",
                  "event entity @s r:open"
               ],
               "target": "self"
            },
            "weight": 1
         },
         "minecraft:closing": {
            "weight": 1,
            "run_command": {
               "command": [
                  "event entity @s minecraft:entity_spawned",
                  "event entity @s r:close"
               ],
               "target": "self"
            }
         },
         "minecraft:rotate": {
            "run_command": {
               "command": [
                  "tp @s ~~~ facing @p"
               ],
               "target": "self"
            },
            "weight": 1
         },
         "minecraft:is_started": {
            "randomize": [
               {
                  "weight": 1,
                  "run_command": {
                     "command": [
                        "playanimation @p animation.react_arm_2",
                        "event entity @s r:open_breaker",
                        "event entity @e[type=r:fire_area2] r:active",
                        "event entity @e[type=r:cutscene_on] r:active"
                     ],
                     "target": "self"
                  }
               }
            ]
         }
      }
   }
}