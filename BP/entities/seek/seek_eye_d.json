{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:seek_eye_d",
         "is_spawnable": false,
         "is_summonable": true,
         "is_experimental": false
      },
      "component_groups": {
         "minecraft:is_dead": {
            "minecraft:transformation": {
               "into": "doors:seek_eye_d"
            }
         },
         "despawning": {
            "minecraft:type_family": {
               "family": [
                  "despawer",
                  "despawer_despawning"
               ]
            }
         }
      },
      "components": {
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:experience_reward": {
            "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
         },
         "minecraft:health": {
            "value": 500
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:spell_effects": {
            "add_effects": [
               {
                  "effect": "instant_health",
                  "duration": 100000,
                  "visible": false,
                  "amplifier": 255,
                  "display_on_screen_animation": false
               }
            ]
         },
         "minecraft:collision_box": {
            "width": 0,
            "height": 0
         },
         "minecraft:scale": {
            "value": 1
         },
         "minecraft:movement.basic": {},
         "minecraft:navigation.climb": {
            "can_path_over_water": true,
            "can_pass_doors": true,
            "can_open_doors": true,
            "can_path_from_air": true
         },
         "minecraft:jump.static": {},
         "minecraft:knockback_resistance": {
            "value": 50
         },
         "minecraft:fall_damage": {
            "value": 2
         },
         "minecraft:despawn": {
            "filters": {
               "all_of": [
                  {
                     "any_of": [
                        {
                           "test": "is_family",
                           "subject": "self",
                           "value": "despawer_despawning"
                        }
                     ]
                  }
               ]
            }
         },
         "minecraft:timer": {
            "looping": false,
            "randomInterval": false,
            "time": 7,
            "time_down_event": {
               "event": "minecraft:start_despawn",
               "target": "self"
            }
         },
         "minecraft:damage_sensor": [
            {
               "deals_damage": false
            }
         ],
         "minecraft:on_death": {
            "event": "on:death",
            "target": "self"
         },
         "minecraft:physics": {
            "has_gravity": false,
            "has_collision": true
         }
      },
      "events": {
         "on:death": {
            "add": {
               "component_groups": [
                  "minecraft:is_dead"
               ]
            }
         },
         "minecraft:start_despawn": {
            "add": {
               "component_groups": [
                  "despawning"
               ]
            }
         }
      }
   }
}