{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "r:invisible",
         "is_spawnable": false,
         "is_summonable": true,
         "is_experimental": false,
         "scripts": {
            "animate": [
               "wala"
            ]
         },
         "animations": {
            "wala": "controller.animation.screech_wala"
         }
      },
      "component_groups": {
         "minecraft:despawndead": {
            "minecraft:type_family": {
               "family": [
                  "despawn_"
               ]
            }
         }
      },
      "components": {
         "minecraft:attack": {
            "damage": 0
         },
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:collision_box": {
            "height": 2,
            "width": 0.4
         },
         "minecraft:underwater_movement": {
            "value": 0.06
         },
         "minecraft:movement.generic": {},
         "minecraft:jump.static": {},
         "minecraft:can_climb": {},
         "minecraft:health": {
            "value": 101,
            "max": 101
         },
         "minecraft:movement": {
            "value": 0
         },
         "minecraft:navigation.generic": {
            "is_amphibious": true,
            "can_path_over_water": false,
            "can_break_doors": true,
            "can_swim": false,
            "can_walk": true,
            "avoid_sun": false
         },
         "minecraft:behavior.move_towards_restriction": {
            "priority": 5,
            "speed_multiplier": 1
         },
         "minecraft:behavior.random_stroll": {
            "priority": 6,
            "speed_multiplier": 1
         },
         "minecraft:behavior.look_at_player": {
            "priority": 7,
            "look_distance": 6,
            "probability": 0.02
         },
         "minecraft:behavior.random_look_around": {
            "priority": 7
         },
         "minecraft:behavior.hurt_by_target": {
            "priority": 3
         },
         "minecraft:physics": {},
         "minecraft:on_target_acquired": {
            "event": "on:target_acquired",
            "target": "self"
         },
         "minecraft:on_target_escape": {
            "event": "on:target_escape",
            "target": "self"
         },
         "minecraft:experience_reward": {
            "on_death": "query.last_hit_by_player ? 10 : 0"
         },
         "minecraft:scale": {
            "value": 1
         },
         "minecraft:behavior.melee_attack": {
            "priority": 2,
            "speed_multiplier": 13,
            "target_dist": 0,
            "max_dist": 3,
            "random_stop_interval": 100,
            "track_target": true,
            "reach_multiplier": 1
         },
         "minecraft:behavior.owner_hurt_by_target": {
            "priority": 1
         },
         "minecraft:behavior.owner_hurt_target": {
            "priority": 2
         },
         "minecraft:behavior.float": {
            "priority": 2,
            "speed_multiplier": 1
         },
         "minecraft:follow_range": {
            "value": 1000
         },
         "minecraft:behavior.nearest_attackable_target": {
            "priority": 1,
            "within_radius": 100,
            "entity_types": [
               {
                  "filters": {
                     "other_with_families": [
                        "player"
                     ]
                  },
                  "max_dist": 100,
                  "sprint_speed_multiplier": 1.1
               }
            ],
            "must_see": true,
            "must_see_forget_duration": 10
         },
         "minecraft:physics": {},
         "minecraft:despawn": {
            "filters": {
               "all_of": [
                  {
                     "test": "is_family",
                     "subject": "self",
                     "value": "despawn_"
                  }
               ]
            }
         },
         "minecraft:timer": {
            "looping": false,
            "randomInterval": false,
            "time": 6,
            "time_down_event": {
               "event": "minecraft:event_dead"
            }
         }
      },
      "events": {
         "minecraft:event_dead": {
            "add": {
               "component_groups": [
                  "minecraft:despawndead"
               ]
            }
         }
      }
   }
}