                  1,
                  1
               ],
               "looping": true,
               "time_down_north_event": {
                  "event": "minecraft:event_dead",
                  "target": "self"
               }
            }
         },
         "minecraft:despawndead": {
            "minecraft:type_family": {
               "family": [
                  "despawn_"
               ]
            }
         }
      },
      "components": {
         "minecraft:knockback_resistance": {
            "value": 1
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:collision_box": {
            "width": 1,
            "height": 1.8
         },
         "minecraft:despawn": {
            "filters": {
               "all_of": [
                  {
                     "test": "is_family",
                     "subject": "self",
                     "value": "despawn_"
                  }
               ]
            }
         },
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:fire_immune": true,
         "minecraft:health": {
            "value": {
               "range_min": 10,
               "range_max": 10
            }
         },
