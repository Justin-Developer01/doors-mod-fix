            "minecraft:interact": {
               "interactions": [
                  {
                     "hurt_item": 0,
                     "interact_text": "§l-Unlock Door-",
                     "on_interact": {
                        "filters": {
                           "all_of": [
                              {
                                 "test": "has_equipment",
                                 "subject": "other",
                                 "domain": "hand",
                                 "value": "r:key"
                              }
                           ]
                        },
                        "event": "minecraft:open",
                        "target": "self"
                     },
                     "swing": true,
                     "use_item": false
                  }
