            "target": "self"
         }
      },
      "events": {
         "minecraft:entity_spawned": {
            "add": {
               "component_groups": [
                  "close"
               ]
            }
         },
         "minecraft:event_dead": {
            "add": {
               "component_groups": [
                  "minecraft:despawndead"
               ]
            }
         },
         "minecraft:open": {
            "add": {
               "component_groups": [
                  "open"
               ]
            },
            "remove": {
               "component_groups": [
                  "close"
               ]
            },
            "run_command": {
               "command": [
                  "clear @a[c=1] r:key",
                  "clear @a[c=1] r:lockpick"
               ],
               "target": "self"
            },
            "weight": 1
         },
         "minecraft:open2": {
            "add": {
               "component_groups": [
                  "open2"
               ]
            },
            "remove": {
               "component_groups": [
                  "close",
                  "close2",
                  "open"
               ]
            }
         },
         "minecraft:close": {
            "add": {
               "component_groups": [
                  "close"
               ]
            },
            "remove": {
               "component_groups": [
                  "open"
               ]
            }
         },
         "minecraft:close2": {
            "add": {
               "component_groups": [
                  "close2"
               ]
            },
            "remove": {
               "component_groups": [
                  "open",
                  "close"
               ]
            }
         },
         "on:death": {
            "randomize": [
               {
                  "weight": 1,
                  "run_command": {
                     "command": [
                        "execute @s ~~~ fill ~~~ ~~1~ air"
                     ],
                     "target": "self"
                  }
               },
               {
                  "weight": 1,
                  "run_command": {
                     "command": [
                        "execute @s ~~~ fill ~~~ ~~1~ air"
                     ],
                     "target": "self"
                  }
               }
            ]
