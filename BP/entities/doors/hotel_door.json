{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:hotel_door",
         "is_spawnable": true,
         "is_summonable": true,
         "is_experimental": false,
         "scripts": {
            "animate": [
               "door_close",
               "door_open",
               "change"
            ]
         },
         "animations": {
            "door_close": "controller.animation.door_close",
            "door_open": "controller.animation.door_open",
            "change": "controller.animation.door_change"
         }
      },
      "component_groups": {
         "inter_open": {
            "minecraft:interact": {
               "interactions": [
                  {
                     "hurt_item": 0,
                     "interact_text": "open door",
                     "on_interact": {
                        "filters": {
                           "all_of": [
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "value": "player"
                              }
                           ]
                        },
                        "event": "minecraft:open",
                        "target": "self"
                     },
                     "swing": true,
                     "use_item": false
                  }
               ]
            },
            "minecraft:variant": {
               "value": 1
            }
         },
         "inter_close": {
            "minecraft:interact": {
               "interactions": [
                  {
                     "hurt_item": 0,
                     "interact_text": "close door",
                     "on_interact": {
                        "filters": {
                           "all_of": [
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "value": "player"
                              }
                           ]
                        },
                        "event": "minecraft:close",
                        "target": "self"
                     },
                     "swing": true,
                     "use_item": false
                  }
               ]
            },
            "minecraft:variant": {
               "value": 1
            },
            "minecraft:damage_sensor": {
               "triggers": [
                  {
                     "cause": "entity_attack",
                     "deals_damage": true
                  },
                  {
                     "cause": "suffocation",
                     "deals_damage": false
                  },
                  {
                     "cause": "projectile",
                     "deals_damage": false
                  },
                  {
                     "cause": "explosion",
                     "deals_damage": false
                  },
                  {
                     "cause": "fire",
                     "deals_damage": false
                  }
               ]
            }
         },
         "close": {
            "minecraft:mark_variant": {
               "value": 1
            },
            "minecraft:damage_sensor": {
               "triggers": [
                  {
                     "cause": "entity_attack",
                     "deals_damage": false
                  },
                  {
                     "cause": "projectile",
                     "deals_damage": false
                  },
                  {
                     "cause": "explosion",
                     "deals_damage": false
                  },
                  {
                     "cause": "fire",
                     "deals_damage": false
                  },
                  {
                     "cause": "fatal",
                     "deals_damage": false
                  }
               ]
            }
         },
         "open": {
            "minecraft:mark_variant": {
               "value": 2
            }
         },
         "gone": {
            "minecraft:timer": {
               "time": [
                  1,
                  1
               ],
               "looping": true,
               "time_down_north_event": {
                  "event": "minecraft:event_dead",
                  "target": "self"
               }
            }
         },
         "minecraft:despawndead": {
            "minecraft:type_family": {
               "family": [
                  "despawn_"
               ]
            }
         },
         "align": {
            "minecraft:spawn_entity": {
               "entities": [
                  {
                     "min_wait_time": 0,
                     "max_wait_time": 0,
                     "spawn_entity": "batim:door",
                     "single_use": true,
                     "num_to_spawn": 1
                  }
               ]
            }
         }
      },
      "components": {
         "minecraft:knockback_resistance": {
            "value": 1
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:collision_box": {
            "width": 1,
            "height": 1.8
         },
         "minecraft:despawn": {
            "filters": {
               "all_of": [
                  {
                     "test": "is_family",
                     "subject": "self",
                     "value": "despawn_"
                  }
               ]
            }
         },
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:fire_immune": true,
         "minecraft:health": {
            "value": {
               "range_min": 10,
               "range_max": 10
            }
         },
         "minecraft:target_nearby_sensor": {
            "inside_range": 1,
            "outside_range": 2,
            "on_inside_range": {
               "event": "minecraft:open",
               "target": "self"
            },
            "on_outside_range": {
               "event": "minecraft:close",
               "target": "self"
            }
         },
         "minecraft:behavior.nearest_attackable_target": {
            "priority": 1,
            "within_radius": 16,
            "reselect_targets": true,
            "entity_types": [
               {
                  "filters": {
                     "all_of": [
                        {
                           "any_of": [
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "operator": "!=",
                                 "value": "inanimate"
                              },
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "operator": "!=",
                                 "value": "player"
                              },
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "operator": "!=",
                                 "value": "dupe"
                              },
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "operator": "!=",
                                 "value": "doors_creature"
                              },
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "operator": "!=",
                                 "value": "monster"
                              },
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "operator": "!=",
                                 "value": "mob"
                              }
                           ]
                        }
                     ]
                  },
                  "max_dist": 16
               }
            ],
            "within_radius": 16,
            "must_see": false,
            "must_see_forget_duration": 5
         },
         "minecraft:loot": {
            "table": "loot_tables/entities/door.json"
         },
         "minecraft:physics": {
            "has_gravity": false,
            "has_collision": false
         },
         "minecraft:on_death": {
            "event": "on:death",
            "target": "self"
         }
      },
      "events": {
         "minecraft:entity_spawned": {
            "add": {
               "component_groups": [
                  "inter_open",
                  "close"
               ]
            }
         },
         "minecraft:to_open": {
            "add": {
               "component_groups": [
                  "inter_open"
               ]
            },
            "remove": {
               "component_groups": [
                  "inter_close"
               ]
            }
         },
         "minecraft:to_close": {
            "add": {
               "component_groups": [
                  "inter_open"
               ]
            },
            "remove": {
               "component_groups": [
                  "inter_close"
               ]
            }
         },
         "minecraft:event_dead": {
            "add": {
               "component_groups": [
                  "minecraft:despawndead"
               ]
            }
         },
         "minecraft:open": {
            "add": {
               "component_groups": [
                  "open",
                  "inter_close"
               ]
            },
            "remove": {
               "component_groups": [
                  "close",
                  "inter_open"
               ]
            }
         },
         "minecraft:close": {
            "add": {
               "component_groups": [
                  "close",
                  "inter_open"
               ]
            },
            "remove": {
               "component_groups": [
                  "open",
                  "inter_close"
               ]
            }
         },
         "on:death": {
            "randomize": [
               {
                  "weight": 1,
                  "run_command": {
                     "command": [
                        "execute @s ~~~ fill ~~~ ~~1~ air"
                     ],
                     "target": "self"
                  }
               },
               {
                  "weight": 1,
                  "run_command": {
                     "command": [
                        "execute @s ~~~ fill ~~~ ~~1~ air"
                     ],
                     "target": "self"
                  }
               }
            ]
         }
      }
   }
}