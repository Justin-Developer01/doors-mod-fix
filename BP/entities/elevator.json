{
   "format_version": "1.13.0",
   "minecraft:entity": {
      "description": {
         "identifier": "doors:elevator",
         "is_spawnable": true,
         "is_summonable": true,
         "is_experimental": false,
         "scripts": {
            "animate": [
               "spawn",
               "system"
            ]
         },
         "animations": {
            "spawn": "controller.animation.elevator_spawn",
            "system": "controller.animation.elevator_system"
         }
      },
      "component_groups": {
         "minecraft:is_spawn": {
            "minecraft:interact": {
               "interactions": [
                  {
                     "hurt_item": 0,
                     "interact_text": "§lEnter Lift",
                     "on_interact": {
                        "filters": {
                           "all_of": [
                              {
                                 "test": "is_family",
                                 "subject": "other",
                                 "value": "player"
                              }
                           ]
                        },
                        "event": "minecraft:is_ride",
                        "target": "self"
                     },
                     "swing": true,
                     "use_item": false
                  }
               ]
            },
            "minecraft:rideable": {
               "rider_can_interact": false,
               "seat_count": 3,
               "seats": [
                  {
                     "position": [
                        0,
                        0,
                        0
                     ]
                  },
                  {
                     "position": [
                        1,
                        0,
                        0
                     ]
                  },
                  {
                     "position": [
                        -1,
                        0,
                        0
                     ]
                  }
               ]
            }
         },
         "minecraft:is_time": {
            "minecraft:timer": {
               "looping": false,
               "randomInterval": false,
               "time": 30,
               "time_down_event": {
                  "event": "r:start"
               }
            }
         }
      },
      "components": {
         "minecraft:knockback_resistance": {
            "value": 9
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": false
         },
         "minecraft:scale": {
            "value": 1
         },
         "minecraft:collision_box": {
            "width": 0.6,
            "height": 1.7
         },
         "minecraft:loot": {
            "table": "loot_tables/entities/noloot.json"
         },
         "minecraft:type_family": {
            "family": [
               "inanimate"
            ]
         },
         "minecraft:fire_immune": true,
         "minecraft:health": {
            "value": {
               "range_min": 100,
               "range_max": 100
            }
         },
         "minecraft:physics": {
            "has_gravity": true,
            "has_collision": true
         }
      },
      "events": {
         "minecraft:entity_spawned": {
            "add": {
               "component_groups": [
                  "minecraft:is_spawn"
               ]
            }
         },
         "minecraft:is_spawn": {
            "add": {
               "component_groups": [
                  "minecraft:is_spawn"
               ]
            }
         },
         "minecraft:is_ride": {
            "add": {
               "component_groups": [
                  "minecraft:is_time"
               ]
            },
            "run_command": {
               "command": [
                  "ride @a[r=3] start_riding @e[type=doors:elevator,r=2]",
                  "effect @e[type=doors:elevator] instant_health 10000 255 true",
                  "say §lReminder: Please have a target mark spawned for the elevator's destination.",
                  "say §lReminder2: Please wait for 30sec for the elevator to start"
               ],
               "target": "self"
            },
            "weight": 1
         },
         "r:start": {
            "run_command": {
               "command": [
                  "playsound mob.elevator.jam @a[r=6]",
                  "effect @e[type=doors:elevator] instant_health 10000 255 true",
                  "summon r:wait",
                  "camerashake add @a[r=5] 0.2 29 positional",
                  "say §lNow transporting to destination..."
               ],
               "target": "self"
            },
            "weight": 1
         },
         "minecraft:reset": {
            "add": {
               "component_groups": [
                  "minecraft:is_spawn"
               ]
            },
            "remove": {
               "component_groups": [
                  "minecraft:is_start",
                  "minecraft:is_ride"
               ]
            }
         },
         "minecraft:rotate": {
            "run_command": {
               "command": [
                  "tp @s ~~~ facing @p"
               ],
               "target": "self"
            },
            "weight": 1
         }
      }
   }
}