{
   "format_version": "1.16.0",
   "minecraft:entity": {
      "description": {
         "identifier": "r:dash",
         "is_spawnable": false,
         "is_summonable": true,
         "is_experimental": false,
         "runtime_identifier": "minecraft:snowball",
         "scripts": {
            "animate": [
               "ride"
            ]
         },
         "animations": {
            "ride": "controller.animation.item_ride"
         }
      },
      "component_groups": {
         "exploding": {
            "minecraft:explode": {
               "fuseLength": 2,
               "power": 4,
               "fuseLit": true,
               "causesFire": false
            }
         },
         "minecraft:remove": {
            "minecraft:despawn": {}
         }
      },
      "components": {
         "minecraft:collision_box": {
            "width": 0.25,
            "height": 0.25
         },
         "minecraft:physics": {
            "has_collision": true,
            "has_gravity": true
         },
         "minecraft:pushable": {
            "is_pushable": false,
            "is_pushable_by_piston": true
         },
         "minecraft:conditional_bandwidth_optimization": {
            "default_values": {
               "max_optimized_distance": 100,
               "max_dropped_ticks": 7,
               "use_motion_prediction_hints": true
            }
         },
         "minecraft:rideable": {
            "seat_count": 1,
            "seats": [
               {
                  "position": [
                     0,
                     1,
                     0
                  ],
                  "rotate_rider_by": -90
               }
            ]
         },
         "minecraft:projectile": {
            "on_hit": {
               "definition_event": {
                  "affect_projectile": false,
                  "event_trigger": {
                     "event": "on:hit",
                     "target": "self"
                  }
               },
               "impact_damage": {
                  "destroy_on_hurt": false,
                  "knockback": false
               },
               "stick_in_ground": {
                  "shake_time": 0
               }
            },
            "liquid_inertia": 2,
            "shoot_target": true,
            "multiple_targets": true,
            "power": 2.2,
            "gravity": 0.05,
            "angle_offset": 0,
            "uncertaintyBase": 16,
            "uncertainty_multiplier": 16
         }
      },
      "events": {
         "on:hit": {
            "run_command": {
               "command": [
                  "kill @s",
                  "tag @p[r=3] remove dash"
               ]
            }
         },
         "minecraft:remove": {
            "add": {
               "component_groups": [
                  "minecraft:remove"
               ]
            }
         }
      }
   }
}